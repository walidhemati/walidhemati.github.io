---
/**
 * Signal-trace divider (plan 3.5 #4, 4.4 #9).
 * A 1px --signal polyline of ~300 points, generated at BUILD time from a
 * seeded EEG-like series (alpha + beta rhythms, slow drift, sparse spikes).
 * Decorative and aria-hidden. Draws left → right on home when .is-in is added
 * (see motion.css); static everywhere else and under reduced motion.
 */
interface Props {
  seed?: number;
  points?: number;
  height?: number;
  class?: string;
  /** label shown at the left edge, e.g. "CH 01 · EEG" (mono, decorative) */
  label?: string;
}

const { seed = 7, points = 300, height = 48, class: className, label } = Astro.props;

// mulberry32: tiny deterministic PRNG so the same seed always yields the same trace
function prng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = prng(seed);
const W = 1000;
const mid = height / 2;
const amp = height * 0.42;
const phaseA = rand() * Math.PI * 2;
const phaseB = rand() * Math.PI * 2;
const spikes = new Set<number>();
for (let i = 0; i < 4; i++) spikes.add(Math.floor(points * (0.15 + rand() * 0.75)));

let prev = 0;
const ys: number[] = [];
for (let i = 0; i < points; i++) {
  const t = i / (points - 1);
  const alpha = Math.sin(t * Math.PI * 2 * 21 + phaseA) * 0.32; // ~10 Hz look
  const beta = Math.sin(t * Math.PI * 2 * 53 + phaseB) * 0.14;
  const drift = Math.sin(t * Math.PI * 2 * 1.3 + phaseA) * 0.18;
  const noise = (rand() - 0.5) * 0.38;
  let v = alpha + beta + drift + noise;
  if (spikes.has(i)) v += (rand() > 0.5 ? 1 : -1) * (0.75 + rand() * 0.35);
  // light smoothing so it reads as a signal, not as noise
  v = prev * 0.35 + v * 0.65;
  prev = v;
  // taper the ends so the divider starts and ends on the baseline
  const taper = Math.min(1, t / 0.06, (1 - t) / 0.06);
  ys.push(Math.max(-1, Math.min(1, v * taper)));
}

const d = ys
  .map((v, i) => `${i === 0 ? 'M' : 'L'}${((i / (points - 1)) * W).toFixed(1)} ${(mid - v * amp).toFixed(2)}`)
  .join('');
---

<div class:list={['signal-trace', className]} aria-hidden="true" data-reveal-trace style={`--trace-h:${height}px`}>
  {label && <span class="signal-trace__label t-label">{label}</span>}
  <svg class="signal-trace__svg" viewBox={`0 0 ${W} ${height}`} preserveAspectRatio="none" focusable="false">
    <line class="signal-trace__base" x1="0" y1={mid} x2={W} y2={mid} vector-effect="non-scaling-stroke" />
    <path class="signal-trace__path" d={d} vector-effect="non-scaling-stroke" />
  </svg>
  <span class="signal-trace__dot" style={`top:${(mid - ys[ys.length - 1] * amp) / height * 100}%`}></span>
</div>

<style>
  .signal-trace {
    position: relative;
    width: 100%;
    height: var(--trace-h);
  }
  .signal-trace__svg {
    width: 100%;
    height: 100%;
  }
  .signal-trace__base {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .signal-trace__path {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .signal-trace__dot {
    position: absolute;
    right: -3px;
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-radius: 50%;
    background: var(--signal);
  }
  .signal-trace__label {
    position: absolute;
    left: 0;
    bottom: calc(100% + 6px);
  }
</style>
