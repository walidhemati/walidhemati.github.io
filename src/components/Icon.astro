---
/**
 * Inline SVG icons (plan section 3.6).
 * Outline icons are copied from Lucide (ISC licence, https://lucide.dev),
 * with square caps / miter joins and radius removed to match the radius-0 system.
 * GitHub and LinkedIn marks are hand-inlined brand glyphs.
 * Every icon is decorative: aria-hidden + focusable=false, always next to a text label.
 */
export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'arrow-down'
  | 'arrow-left'
  | 'download'
  | 'mail'
  | 'copy'
  | 'check'
  | 'sun'
  | 'moon'
  | 'pause'
  | 'play'
  | 'replay'
  | 'external'
  | 'command'
  | 'menu'
  | 'close'
  | 'github'
  | 'linkedin';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 16, class: className, strokeWidth = 1.5 } = Astro.props;

const STROKE: Record<string, string> = {
  'arrow-right': '<path d="M4 12h16"/><path d="m13 5 7 7-7 7"/>',
  'arrow-left': '<path d="M20 12H4"/><path d="m11 5-7 7 7 7"/>',
  'arrow-up-right': '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
  'arrow-down': '<path d="M12 4v16"/><path d="m19 13-7 7-7-7"/>',
  download: '<path d="M21 15v6H3v-6"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/>',
  mail: '<path d="M2 4h20v16H2z"/><path d="m22 6-10 7L2 6"/>',
  copy: '<path d="M8 8h14v14H8z"/><path d="M4 16H2V2h14v2"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  pause: '<path d="M14 4h4v16h-4z"/><path d="M6 4h4v16H6z"/>',
  play: '<path d="M6 3l14 9-14 9z"/>',
  replay: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>',
  external: '<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v8H3V6h8"/>',
  command: '<path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"/>',
  menu: '<path d="M3 8h18"/><path d="M3 16h18"/>',
  close: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
};

const FILLED: Record<string, { viewBox: string; d: string }> = {
  github: {
    viewBox: '0 0 16 16',
    d: 'M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z',
  },
  linkedin: {
    viewBox: '0 0 24 24',
    d: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 4.892v4.892zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
};

const filled = FILLED[name];
const inner = filled ? `<path d="${filled.d}"/>` : STROKE[name];
const viewBox = filled ? filled.viewBox : '0 0 24 24';
---

<svg
  class:list={['icon', `icon--${name}`, className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={viewBox}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={filled ? undefined : strokeWidth}
  stroke-linecap={filled ? undefined : 'square'}
  stroke-linejoin={filled ? undefined : 'miter'}
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
