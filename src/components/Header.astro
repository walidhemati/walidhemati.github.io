---
/**
 * Site header (plan 4.4 #6, #7; wireframe 5.3).
 *  - Logo · numbered nav [01] Work [02] About [03] Now [04] Contact · CV ↓ · theme
 *  - Active link carries corner brackets (view-transition-name: nav-brackets)
 *  - Hides on scroll down / shows on scroll up; ALWAYS shows on :focus-within
 *    and on any Tab keydown (WCAG 2.4.11). Hide-on-scroll is off under reduced motion.
 *  - Mobile: full-screen inverted <dialog> (inert when closed, Esc closes,
 *    focus returns to the toggle). Open/close are CSS-only transitions with
 *    @starting-style + transition-behavior: allow-discrete.
 */
import { NAME, NAV, CV_HREF, CV_PDF, EMAIL, SOCIALS } from '../site.config';
import Brackets from './Brackets.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  return href === '/' ? path === '/' : path.startsWith(href);
};
const cvIsPdf = Boolean(CV_PDF);
// Archivo leaves an open "TI" pair at small sizes ("HEMAT I"); tuck the T in by hand.
const logoParts = NAME.split(/(T)(?=I)/i).filter(Boolean);
---

<header class="site-header" data-header>
  <div class="site-header__bar wrap">
    <a class="site-header__logo" href="/" aria-label={`${NAME}, home`}>
      <span class="logo-mark" aria-hidden="true">
        <span class="logo-mark__w">W</span>
        <Brackets size="5px" tone="signal" />
      </span>
      <span class="logo-name">{logoParts.map((part) => (/^t$/i.test(part) ? <span class="logo-kern">{part}</span> : part))}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list" role="list">
        {
          NAV.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a class:list={['site-nav__link', { 'is-active': active }]} href={item.href} aria-current={active ? 'page' : undefined}>
                  <span class="site-nav__n" aria-hidden="true">[{item.n}]</span>
                  <span class="site-nav__label">{item.label}</span>
                  {active && <Brackets size="6px" inset="6px" vtName="nav-brackets" />}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="site-header__cv" href={CV_HREF} download={cvIsPdf ? '' : undefined}>
        <span>CV</span>
        <Icon name="arrow-down" size={14} />
      </a>
      <ThemeToggle />
      <button
        type="button"
        class="menu-toggle"
        data-js-only
        aria-haspopup="dialog"
        aria-controls="site-menu"
        aria-expanded="false"
        data-menu-open
      >
        <span>Menu</span>
        <Icon name="menu" size={16} />
      </button>
    </div>
  </div>
</header>

<dialog id="site-menu" class="menu invert" aria-label="Menu" data-menu>
  <div class="menu__inner wrap">
    <div class="menu__top">
      <span class="t-label">Index</span>
      <button type="button" class="menu__close" data-menu-close>
        <span>Close</span>
        <Icon name="close" size={16} />
      </button>
    </div>
    <nav aria-label="Primary (menu)">
      <ul class="menu__list" role="list">
        {
          NAV.map((item, i) => (
            <li style={`--i:${i}`}>
              <a class="menu__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span class="menu__n t-label" aria-hidden="true">{item.n}</span>
                <span class="menu__label">{item.label}</span>
              </a>
            </li>
          ))
        }
        <li style={`--i:${NAV.length}`}>
          <a class="menu__link" href={CV_HREF} download={cvIsPdf ? '' : undefined}>
            <span class="menu__n t-label" aria-hidden="true">CV</span>
            <span class="menu__label">CV <Icon name="download" size={16} class="menu__dl" /></span>
          </a>
        </li>
      </ul>
    </nav>
    <div class="menu__foot t-mono">
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a href={SOCIALS.github.url} rel="me noopener">GitHub ↗</a>
      <a href={SOCIALS.linkedin.url} rel="me noopener">LinkedIn ↗</a>
    </div>
  </div>
</dialog>

<style>
  /* ---------------- Bar ---------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    transition: transform var(--dur-3) var(--ease-out);
  }
  .site-header__bar {
    height: var(--header-h);
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--gutter);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion='reduce'])) .site-header.is-hidden {
      transform: translate3d(0, -100%, 0);
    }
  }
  /* Never hide while it holds focus (WCAG 2.4.11) */
  .site-header:focus-within { transform: none !important; }

  /* ---------------- Logo ---------------- */
  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    padding-right: var(--gutter);
    border-right: 1px solid var(--rule);
    min-width: 0;
  }
  .logo-mark {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex: none;
  }
  .logo-mark__w {
    font-family: var(--font-sans);
    font-weight: 700;
    font-stretch: 72%;
    font-size: 15px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  /* condensed 72% falls apart at 17px ("HEMAT I"): open the width and tracking */
  .logo-name {
    font-weight: 650;
    font-stretch: 85%;
    font-size: 1.0625rem;
    letter-spacing: .005em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .logo-kern { letter-spacing: -0.075em; }

  /* ---------------- Nav (desktop) ---------------- */
  .site-nav { display: none; }
  .site-nav__list {
    display: flex;
    align-items: stretch;
    height: 100%;
    gap: clamp(var(--sp-4), 2.4vw, var(--sp-7));
  }
  .site-nav__list > li { display: flex; align-items: center; }
  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 6px 2px;
    text-decoration: none;
    font-size: .9375rem;
    font-weight: 500;
  }
  .site-nav__n {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-s);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .site-nav__label { position: relative; }
  .site-nav__label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .site-nav__link:hover .site-nav__label::after,
  .site-nav__link:focus-visible .site-nav__label::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }
  .site-nav__link.is-active .site-nav__n { color: var(--signal-text); }

  /* ---------------- Tools ---------------- */
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    padding-left: var(--gutter);
    border-left: 1px solid var(--rule);
  }
  .site-header__cv {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding-inline: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    text-decoration: none;
  }
  .site-header__cv:hover { color: var(--signal-text); }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding-left: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
  }

  @media (max-width: 479px) {
    .site-header__logo { border-right: 0; padding-right: 0; }
    .logo-name { font-size: 1rem; }
    .site-header__tools { border-left: 0; padding-left: 0; }
    .menu-toggle > span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .menu-toggle { width: 44px; justify-content: center; padding: 0; }
  }

  @media (min-width: 1024px) {
    .site-nav { display: flex; flex: 1; justify-content: flex-start; }
    .menu-toggle { display: none; }
  }

  /* ---------------- Dialog menu ---------------- */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path var(--dur-3) var(--ease-inout),
      display var(--dur-3) allow-discrete,
      overlay var(--dur-3) allow-discrete;
  }
  .menu[open] { clip-path: inset(0 0 0 0); }
  @starting-style {
    .menu[open] { clip-path: inset(0 0 100% 0); }
  }
  .menu::backdrop { background: transparent; }

  .menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding-block: var(--sp-4) var(--sp-7);
  }
  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(var(--header-h) - var(--sp-4));
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--sp-7);
  }
  .menu__close {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
  }
  .menu__list > li { border-bottom: 1px solid var(--rule); }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    padding-block: var(--sp-3);
    text-decoration: none;
  }
  .menu nav { margin-top: auto; }
  .menu__label {
    font-size: clamp(2.75rem, 12vw, 4rem);
    font-weight: 600;
    font-stretch: 85%;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .menu__link[aria-current='page'] .menu__n { color: var(--signal-text); }
  .menu__n { min-width: 2.5em; }
  .menu__label :global(.menu__dl) { width: .6em; height: .6em; display: inline-block; vertical-align: .05em; }

  /* Links rise with a .06 stagger as the panel opens */
  .menu__list > li {
    transition:
      transform var(--dur-3) var(--ease-out) calc(120ms + var(--i) * var(--stagger-row)),
      opacity var(--dur-3) var(--ease-out) calc(120ms + var(--i) * var(--stagger-row));
  }
  .menu:not([open]) .menu__list > li { transform: translate3d(0, 24px, 0); opacity: 0; }
  @starting-style {
    .menu[open] .menu__list > li { transform: translate3d(0, 24px, 0); opacity: 0; }
  }

  .menu__foot {
    padding-top: var(--sp-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-5);
    color: var(--ink-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu, .menu__list > li { transition: none; }
  }
  :global(:root[data-motion='reduce']) .menu,
  :global(:root[data-motion='reduce']) .menu__list > li { transition: none; }

  :global(html:has(dialog.menu[open])) { overflow: hidden; }
</style>

<script>
  /* ---- Mobile menu ---- */
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (dialog && openBtn) {
    openBtn.addEventListener('click', () => {
      dialog.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    closeBtn?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      if (hashTarget) {
        const t = hashTarget;
        hashTarget = null;
        if (!t.hasAttribute('tabindex')) t.setAttribute('tabindex', '-1');
        history.pushState(null, '', `#${t.id}`);
        t.focus({ preventScroll: true });
        t.scrollIntoView({ block: 'start' });
        return;
      }
      openBtn.focus({ preventScroll: true });
    });
    // Same-page anchors (/#contact): close the dialog, then move focus to the
    // target instead of letting the close handler send it back to the toggle.
    let hashTarget: HTMLElement | null = null;
    dialog.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) =>
      a.addEventListener('click', (e) => {
        const url = new URL(a.href, location.href);
        const target = url.pathname === location.pathname && url.hash ? document.getElementById(decodeURIComponent(url.hash.slice(1))) : null;
        if (target) {
          e.preventDefault();
          hashTarget = target;
        }
        dialog.close();
      }),
    );
    // Close if the viewport grows past the desktop breakpoint
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && dialog.open) dialog.close();
    });
  }

  /* ---- Page-transition hairline (4.4 #1): fills only while navigating ---- */
  const bar = document.querySelector<HTMLElement>('[data-nav-progress]');
  if (bar) {
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (a.target && a.target !== '_self') return;
      if (a.hasAttribute('download')) return;
      const url = new URL(a.href, location.href);
      if (url.origin !== location.origin) return;
      if (url.pathname === location.pathname && url.hash) return;
      bar.classList.add('is-active');
    });
    window.addEventListener('pageshow', () => bar.classList.remove('is-active'));
  }

  /* ---- Hide on scroll down, show on scroll up / Tab / focus ---- */
  const header = document.querySelector<HTMLElement>('[data-header]');
  const root = document.documentElement;
  const osReduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const reduce = () => osReduce.matches || root.getAttribute('data-motion') === 'reduce';

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const dy = y - lastY;
      if (reduce() || y < 120 || header.contains(document.activeElement)) {
        header.classList.remove('is-hidden');
      } else if (dy > 6) {
        header.classList.add('is-hidden');
      } else if (dy < -6) {
        header.classList.remove('is-hidden');
      }
      if (Math.abs(dy) > 6) lastY = y;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') header.classList.remove('is-hidden');
    });
    header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
  }
</script>
