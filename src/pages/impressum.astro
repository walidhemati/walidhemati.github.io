---
/**
 * Impressum (§ 5 DDG), German, noindex, excluded from the sitemap (plan 7.3).
 * The address comes from IMPRESSUM_ADDRESS in src/site.config.ts. While it is
 * empty, a clearly marked placeholder renders instead. No motion JS here.
 */
import Base from '../layouts/Base.astro';
import { EMAIL, IMPRESSUM_ADDRESS, NAME, SITE_URL } from '../site.config';

const addressLines = IMPRESSUM_ADDRESS.split('\n').map((l) => l.trim()).filter(Boolean);
const host = SITE_URL.replace(/^https?:\/\//, '');
---

<Base title={`Impressum: ${NAME}`} description={`Impressum von ${NAME}.`} lang="de" noindex motion={false}>
  <Fragment set:html="<!-- Rechtlicher Hinweis: Entwurf, bitte prüfen -->" />
  <section class="legal wrap grid">
    <p class="col-label t-label legal__label">Rechtliches · 01</p>
    <div class="col-copy legal__body">
      <h1 class="legal__title">Impressum</h1>

      <div class="legal__block">
        <h2 class="t-label">Angaben gemäß § 5 DDG</h2>
        <address class="legal__address">
          {NAME}<br />
          {
            addressLines.length > 0 ? (
              addressLines.map((l) => (
                <>
                  {l}
                  <br />
                </>
              ))
            ) : (
              <strong class="placeholder" lang="en">[Address to be added before publishing]</strong>
            )
          }
        </address>
      </div>

      <div class="legal__block">
        <h2 class="t-label">Kontakt</h2>
        <p>E-Mail: <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
      </div>

      <div class="legal__block">
        <h2 class="t-label">Haftung für Links</h2>
        <p>
          Diese Website enthält Links zu externen Websites Dritter, auf deren Inhalte ich keinen Einfluss habe. Für diese Inhalte ist
          der jeweilige Anbieter oder Betreiber verantwortlich. Bei Bekanntwerden von Rechtsverletzungen entferne ich solche Links
          umgehend.
        </p>
      </div>

      <p class="t-mono c-ink-3 legal__meta">{host} · <a href="/datenschutz/">Datenschutzerklärung</a></p>
    </div>
  </section>
</Base>

<style>
  .legal { padding-block: var(--sp-9) var(--section-pad); row-gap: var(--sp-5); }
  @media (min-width: 1024px) { .legal { padding-top: var(--sp-10); } .legal__label { padding-top: 1.2em; } }
  .legal__title {
    font-size: var(--fs-h1);
    font-stretch: 72%;
    font-weight: 700;
    line-height: .88;
    letter-spacing: -0.045em;
    margin-bottom: var(--sp-8);
  }
  .legal__block { padding-block: var(--sp-5); border-top: 1px solid var(--rule); display: grid; gap: var(--sp-3); }
  .legal__block h2 { font-size: var(--fs-mono-s); line-height: 1.3; letter-spacing: .06em; font-stretch: 100%; }
  .legal__block a, .legal__meta a { color: var(--signal-text); text-decoration-color: currentColor; }
  .legal__address { font-style: normal; font-size: var(--fs-lead); line-height: 1.35; }
  .legal__meta { margin-top: var(--sp-7); }
  .placeholder {
    display: inline-block;
    margin-top: var(--sp-2);
    padding: var(--sp-1) var(--sp-2);
    border: 1px dashed var(--signal);
    color: var(--signal-text);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
  }
</style>
