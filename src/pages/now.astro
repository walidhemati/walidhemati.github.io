---
/**
 * /now (plan 5.2): a dated monthly focus, rendered from the `now` collection.
 * Newest entry on top; older months listed below as an archive.
 * Draft entries carry a visible "Draft" marker.
 */
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { NAME } from '../site.config';

const entries = (await getCollection('now')).sort((a, b) => b.data.month.valueOf() - a.data.month.valueOf());
const latest = entries[0];
const older = entries.slice(1);
const { Content } = latest ? await render(latest) : { Content: null };
const month = (d: Date) => d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const day = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title={`Now: ${NAME}`} description="What Walid Hemati is focused on this month." noindex={Boolean(latest?.data.draft)}>
  <section class="now-head wrap grid">
    <p class="col-label t-label now-head__label">[ 03 ] Now</p>
    <div class="now-head__main">
      <h1 class="now-title">
        Now<span class="now-title__month">{latest ? <span class="t-accent">{month(latest.data.month)}</span> : null}</span>
      </h1>
      {
        latest && (
          <p class="t-mono now-meta">
            <span>
              Updated <time datetime={iso(latest.data.updated)}>{day(latest.data.updated)}</time>
            </span>
            {latest.data.draft && import.meta.env.DEV && <span class="now-draft">Draft</span>}
          </p>
        )
      }
    </div>
  </section>

  <section class="wrap grid now-body" aria-label={latest ? `Focus for ${month(latest.data.month)}` : 'Focus'}>
    <div class="col-label now-note">
      <p class="t-mono c-ink-3">
        What I'm focused on this month. A <a href="https://sive.rs/nowff" rel="noopener">now page</a>, updated when things change.
      </p>
    </div>
    <div class="col-copy now-list">
      {Content && <Content />}
    </div>
  </section>

  {
    older.length > 0 && (
      <section class="section wrap grid" aria-labelledby="now-older">
        <h2 id="now-older" class="col-label t-label">Earlier</h2>
        <ul class="col-copy now-older" role="list">
          {older.map((e) => (
            <li class="t-mono">{month(e.data.month)}</li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .now-head { padding-block: var(--sp-9) var(--sp-7); row-gap: var(--sp-5); }
  .now-head__main { display: grid; gap: var(--sp-5); }
  @media (min-width: 1024px) {
    .now-head { padding-block: var(--sp-10) var(--sp-8); }
    .now-head__label { padding-top: 1.4em; }
    .now-head__main { grid-column: 4 / -1; }
  }
  .now-title {
    font-size: var(--fs-mega);
    font-stretch: 72%;
    font-weight: 700;
    line-height: .82;
    letter-spacing: -0.05em;
  }
  .now-title__month {
    display: block;
    margin-top: .12em;
    font-size: .42em;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--signal-text);
  }
  .now-meta { display: flex; flex-wrap: wrap; gap: var(--sp-4); color: var(--ink-3); }
  .now-draft {
    padding: 0 var(--sp-2);
    border: 1px dashed var(--signal);
    color: var(--signal-text);
    text-transform: uppercase;
    font-size: var(--fs-mono-s);
    letter-spacing: .06em;
    line-height: 1.7;
  }

  .now-body { padding-bottom: var(--section-pad); row-gap: var(--sp-6); }
  .now-note a { color: inherit; }
  .now-note p { max-width: 28ch; }
  .now-list :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: now;
    border-top: 1px solid var(--rule-strong);
  }
  .now-list :global(li) {
    counter-increment: now;
    position: relative;
    padding: var(--sp-5) 0 var(--sp-5) 3.5rem;
    border-bottom: 1px solid var(--rule);
    font-size: var(--fs-lead);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .now-list :global(li)::before {
    content: counter(now, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: calc(var(--sp-5) + .45em);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-s);
    letter-spacing: .06em;
    color: var(--signal-text);
  }
  .now-list :global(strong) { font-weight: 600; }
  .now-older li + li { margin-top: var(--sp-2); }
</style>
